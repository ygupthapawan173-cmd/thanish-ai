name: Publish Verified OMEGA Self-Update Release

on:
  push:
    tags:
      - 'v*'
  workflow_dispatch:
    inputs:
      tag_name:
        description: 'Release tag (e.g. v19.1)'
        required: true
        default: 'v19.1'

permissions:
  contents: write

jobs:
  release:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Set up JDK 17
        uses: actions/setup-java@v4
        with:
          distribution: 'temurin'
          java-version: '17'

      - name: Setup Gradle
        uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: '8.11.1'

      - name: Run Mandatory Unit Tests
        run: gradle :app:testDebugUnitTest --no-daemon

      - name: Build APK
        run: gradle :app:assembleDebug --no-daemon

      - name: Generate SHA-256 Checksum
        id: sha
        run: |
          APK="app/build/outputs/apk/debug/app-debug.apk"
          HASH=$(sha256sum "$APK" | awk '{print $1}')
          echo "$HASH" > app/build/outputs/apk/debug/app-debug.apk.sha256
          echo "sha256=$HASH" >> "$GITHUB_OUTPUT"

      - name: Create GitHub Release
        uses: softprops/action-gh-release@v2
        with:
          tag_name: ${{ inputs.tag_name || github.ref_name }}
          name: "OMEGA Pandu ${{ inputs.tag_name || github.ref_name }}"
          body: |
            Verified OMEGA Pandu Self-Update Release.
            SHA256: ${{ steps.sha.outputs.sha256 }}
          files: |
            app/build/outputs/apk/debug/app-debug.apk
            app/build/outputs/apk/debug/app-debug.apk.sha256
